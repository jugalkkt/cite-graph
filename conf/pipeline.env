# Central configuration for the Academic Citation Network Analyzer.
# Every script in scripts/ sources this file through scripts/common.sh.
# Values can be overridden from the environment, e.g. DRIVER_MEMORY=4g ./run_pipeline.sh

# --- Tool versions -----------------------------------------------------------
SPARK_VERSION="${SPARK_VERSION:-4.0.4}"
SPARK_PACKAGE="spark-${SPARK_VERSION}-bin-hadoop3"
SPARK_SCALA_VERSION="${SPARK_SCALA_VERSION:-2.13.16}"   # must match jars/scala-library-*.jar in Spark

# --- Install locations (everything lives inside the project folder) -----------
SPARK_HOME="${SPARK_HOME_OVERRIDE:-$PROJECT_ROOT/tools/$SPARK_PACKAGE}"
HADOOP_HOME="${HADOOP_HOME:-$HOME/hadoop}"
HADOOP_CONF_DIR="${HADOOP_CONF_DIR:-$HADOOP_HOME/etc/hadoop}"
# Spark 4 needs Java 17+. The course shell exports Java 8, so pin Java 21 here.
JAVA_HOME="${CITATION_JAVA_HOME:-/usr/lib/jvm/java-21-openjdk-amd64}"

# --- Dataset -----------------------------------------------------------------
# ogbn-mag paper-citation graph: 736 K papers from all sciences, 5.4 M citations, 2010-2019,
# labels = 349 publication venues (MAG venue ids). No titles ship with it.
DATASET_URL="https://snap.stanford.edu/ogb/data/nodeproppred/mag.zip"

# --- Local folders -----------------------------------------------------------
RAW_DIR="$PROJECT_ROOT/data/raw"
RESULTS_DIR="${RESULTS_DIR:-$PROJECT_ROOT/results-mag}"
APP_JAR="$PROJECT_ROOT/spark-app/target/citation-analyzer.jar"
# Spark shuffle/spill scratch space. Must be on disk: on many Linux systems /tmp is a RAM-backed
# tmpfs, so Spark's default scratch space there silently consumes memory.
SPARK_SCRATCH="${SPARK_SCRATCH:-$PROJECT_ROOT/data/spark-scratch}"

# --- HDFS layout ---------------------------------------------------------------
HDFS_BASE="${HDFS_BASE:-/user/$USER/citation-mag}"
HDFS_RAW="$HDFS_BASE/raw"          # stage 0: raw files exactly as downloaded (decompressed)
HDFS_CLEAN="$HDFS_BASE/clean"      # stage 1: Spark ETL output (Parquet)
HDFS_GRAPH="$HDFS_BASE/graph"      # stage 2: GraphX output (Parquet + CSV summaries)

# --- Spark runtime -------------------------------------------------------------
# Sized for a 16 GB laptop: 4 task slots and a 6 GB heap; a full run completes inside the 8 GB cap.
SPARK_MASTER="${SPARK_MASTER:-local[4]}"
DRIVER_MEMORY="${DRIVER_MEMORY:-6g}"
SHUFFLE_PARTITIONS="${SHUFFLE_PARTITIONS:-16}"
# Hard ceiling for the Spark JVM (heap + off-heap), enforced by a systemd cgroup when available.
# If Spark exceeds it, only Spark is killed: the OOM killer never touches other applications.
MEMORY_CAP_MB="${MEMORY_CAP_MB:-8192}"

# --- Algorithm parameters ------------------------------------------------------
PAGERANK_TOL="${PAGERANK_TOL:-0.0001}"
PAGERANK_RESET="${PAGERANK_RESET:-0.15}"
LPA_MAX_STEPS="${LPA_MAX_STEPS:-10}"
LANDMARKS="${LANDMARKS:-5}"
